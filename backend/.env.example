# ----------------------------------------------------------------------
# Local development — copy this file to .env and fill in real values.
# ----------------------------------------------------------------------

# Database
# - Local dev (zero setup):  sqlite:///./health.db
# - Production (Neon):       postgresql://user:password@ep-xxx.aws.neon.tech/healthdb?sslmode=require
DATABASE_URL=sqlite:///./health.db

# JWT — generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Groq — get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS — comma-separated list of allowed origins.
# Local:       http://localhost:5173
# Production:  https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
